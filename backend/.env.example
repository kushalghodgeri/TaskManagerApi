# Secret key for JWT token signing (generate using `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# JWT algorithm
ALGORITHM=HS256

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database connection URL (SQLite by default)
DATABASE_URL=sqlite:///./tasks.db

# CORS allowed origins (JSON array or comma-separated list of URLs)
CORS_ORIGINS=["http://localhost:5173"]
